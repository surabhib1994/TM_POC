{
  "name": "python-etl-job-qa",
  "existing_cluster_id": "your-qa-cluster-id",
  "libraries": [
    {
      "whl": "dbfs:/FileStore/python_deployments/qa/deployment-{BUILD_ID}/your-package-0.1.0-py3-none-any.whl"
    },
    {
      "pypi": {
        "package": "pandas"
      }
    },
    {
      "pypi": {
        "package": "numpy"
      }
    }
  ],
  "spark_python_task": {
    "python_file": "dbfs:/FileStore/python_deployments/qa/deployment-{BUILD_ID}/main.py",
    "parameters": ["--env", "qa", "--input-path", "/data/qa/input", "--output-path", "/data/qa/output"]
  },
  "email_notifications": {
    "on_success": ["qa-team@example.com"],
    "on_failure": ["qa-team@example.com", "dev-team@example.com"]
  },
  "timeout_seconds": 5400,
  "max_retries": 2,
  "retry_on_timeout": true,
  "min_retry_interval_millis": 180000,
  "schedule": {
    "quartz_cron_expression": "0 0 12 * * ?",
    "timezone_id": "UTC"
  },
  "tags": {
    "environment": "qa",
    "department": "data-engineering",
    "criticality": "medium",
    "deployed-by": "ci-cd-pipeline"
  }
}

// USAGE NOTES:
